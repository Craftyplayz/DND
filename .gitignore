# Server-only data: friends' sheet backups, session recordings and caches. Never commit these.
private/dnd/backups/
private/dnd/monster-backups/
private/transcripts/*.ogg
private/transcripts/transcripts/
transcripts/data/*
!transcripts/data/.gitignore
!transcripts/data/.htaccess
characters/cache/*
!characters/cache/.gitignore
!characters/cache/.htaccess
private/.htpasswd
includes/config.php
private/sessions/*
!private/sessions/.gitignore
!private/sessions/.htaccess
private/dnd/accounts/*
!private/dnd/accounts/.gitignore
!private/dnd/accounts/.htaccess
.env

# the live relay's packages, installed in the image (Dockerfile) and by npm install in live/
live/node_modules/

# agent worktrees (git worktree add), never part of the site
.claude/worktrees/
