# there is no /sheets/ page; the breadcrumbs on the test sheet link to it
RedirectMatch 301 ^/sheets/?$ /

# the session recordings are archived for the owner (ROADMAP 1.9): transcripts/data stays in its volume but never opens from here
RedirectMatch 301 ^/transcripts(/.*)?$ /campaigns/

# Browser caching for static files outside /assets (those aren't versioned, so keep it short)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg|ico|mp3|mp4|ogg|glb|woff2?)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
