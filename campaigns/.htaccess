# /campaigns/<id> opens that campaign (campaigns/index.php), /campaigns/<id>/map its battle map (campaigns/map.php) and
# /campaigns/<id>/table its Table view (campaigns/table.php); real files (api.php) and folders (join/) are served as they are
RewriteEngine On
RewriteRule ^([A-Za-z0-9_-]+)/map/?$ map.php?c=$1 [L,QSA]
RewriteRule ^([A-Za-z0-9_-]+)/table/?$ table.php?c=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z0-9_-]+)/?$ index.php?c=$1 [L,QSA]
