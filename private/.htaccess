# Password protection for everything in /private/
#
# The password file: create it in Git Bash on your PC (it asks for the password twice):
#        printf 'crafty:%s\n' "$(openssl passwd -apr1)" > .htpasswd
# and put it in the site's host folder on the Docker server (/opt/dnd/live or /opt/dnd/test, see .env.example).
# The container mounts that folder at /etc/dnd, and private/.htpasswd is a link to /etc/dnd/.htpasswd.
# Without the file, /private/ shows an error instead of opening - it never fails open.

AuthType Basic
AuthName "Private"
AuthUserFile /var/www/html/private/.htpasswd
Require valid-user

# never serve the password file itself
<Files ".ht*">
    Require all denied
</Files>

# keep these pages out of search engines
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>
